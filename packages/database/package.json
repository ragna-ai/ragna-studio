{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.mts",
      "import": "./dist/schema/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:seed": "bun src/seed/index.ts",
    "db:backup": "bun src/scripts/backup.ts",
    "credits:grant": "bun src/scripts/grant-credits.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/workflow": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-seed": "1.0.0-rc.4",
    "fractional-indexing": "^4.0.0",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
