{
  "name": "@repo/crypto",
  "version": "0.0.0",
  "private": true,
  "description": "Envelope encryption for secrets at rest with APP_KEY rotation",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "key:generate": "node src/scripts/generate-key.ts"
  },
  "dependencies": {
    "@repo/config": "workspace:*"
  },
  "devDependencies": {
    "@repo/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
