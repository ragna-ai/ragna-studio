{
  "name": "@repo/mail",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./provider": {
      "types": "./dist/provider/index.d.mts",
      "import": "./dist/provider/index.mjs"
    },
    "./content": {
      "types": "./dist/content/index.d.mts",
      "import": "./dist/content/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "maizzle:dev": "maizzle serve --config maizzle.config.ts",
    "maizzle:build": "maizzle build --config maizzle.config.ts"
  },
  "dependencies": {
    "@maizzle/framework": "6.1.7",
    "@maizzle/tailwindcss": "1.5.6",
    "@repo/config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@truto/turndown-plugin-gfm": "^1.0.3",
    "email-reply-parser": "^2.3.9",
    "html-to-text": "^10.0.1",
    "isomorphic-dompurify": "^4.1.0",
    "marked": "18.0.13",
    "nodemailer": "^10.0.10",
    "nodemailer-brevo-transport": "^2.2.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@repo/ts-config": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "catalog:",
    "@types/turndown": "^5.0.6",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
