{
  "name": "@repo/mail",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./provider": {
      "types": "./dist/provider/index.d.mts",
      "import": "./dist/provider/index.mjs"
    },
    "./content": {
      "types": "./dist/content/index.d.mts",
      "import": "./dist/content/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "maizzle:dev": "maizzle serve --config maizzle.config.ts",
    "maizzle:build": "maizzle build --config maizzle.config.ts"
  },
  "dependencies": {
    "@maizzle/framework": "6.2.2",
    "@maizzle/tailwindcss": "1.5.6",
    "@repo/config": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/utils": "workspace:*",
    "email-reply-parser": "^2.3.9",
    "isomorphic-dompurify": "^4.6.0",
    "marked": "18.1.1",
    "mdream": "catalog:",
    "nodemailer": "^10.1.7",
    "nodemailer-brevo-transport": "^2.2.1"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@repo/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
