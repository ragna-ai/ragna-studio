{
  "name": "@repo/integrations",
  "version": "0.0.0",
  "private": true,
  "description": "Provider connections: catalog, OAuth adapters, envelope crypto and token service",
  "license": "AGPL-3.0-only",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.mts",
      "import": "./dist/catalog/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/crypto": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/utils": "workspace:*",
    "oauth4webapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
