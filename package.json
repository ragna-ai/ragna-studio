{
  "name": "ragna-studio-7",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/worker",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "gen": "turbo gen",
    "preview": "turbo run preview",
    "test:api": "turbo run test --filter=@repo/api",
    "pkg:update": "pnpm update -i -r -L",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:backup": "pnpm --filter @repo/database db:backup",
    "docs:index": "node scripts/docs-index.mjs",
    "ci": "pnpm clean --lockfile && pnpm install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.11",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.10.11",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
