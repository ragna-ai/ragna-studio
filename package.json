{
  "name": "ragna-studio-7",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/worker",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "gen": "turbo gen",
    "preview": "turbo run preview",
    "test:api": "turbo run test --filter=@repo/api",
    "pkg:update": "pnpm update -i -r -L",
    "db:push": "pnpm --filter @repo/database db:push",
    "docs:index": "node scripts/docs-index.mjs",
    "ci": "pnpm clean --lockfile && pnpm install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.10.9",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
