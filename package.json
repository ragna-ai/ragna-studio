{
  "name": "ragna-studio-7",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/worker",
    "dev:all": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@repo/docs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "turbo run check-types",
    "gen": "turbo gen",
    "preview": "turbo run preview",
    "test:setup": "pnpm --filter @repo/testing test:setup",
    "test:api": "turbo run test --filter=@repo/api",
    "test:worker": "turbo run test --filter=@repo/worker",
    "pkg:update": "pnpm update -i -r -L",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:backup": "pnpm --filter @repo/database db:backup",
    "specs:index": "node scripts/specs-index.mjs",
    "ci": "pnpm clean --lockfile && pnpm install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
