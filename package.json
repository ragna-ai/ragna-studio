{
  "name": "ragna-studio-7",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@repo/web --filter=@repo/api --filter=@repo/worker",
    "dev:all": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@repo/docs",
    "lint": "oxlint",
    "check-types": "turbo run check-types",
    "gen": "turbo gen",
    "preview": "turbo run preview",
    "test:setup": "pnpm --filter @repo/testing test:setup",
    "test:api": "turbo run test --filter=@repo/api",
    "pkg:update": "pnpm update -i -r -L",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:backup": "pnpm --filter @repo/database db:backup",
    "specs:index": "node scripts/specs-index.mjs",
    "ci": "pnpm clean --lockfile && pnpm install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "license": "AGPL-3.0-only"
}
