{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'schedule:weekly',
    'group:allNonMajor',
    ':disablePeerDependencies',
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  timezone: 'Europe/Berlin',
  labels: ['dependencies'],
  draftPR: true,
  dependencyDashboard: false,
  rangeStrategy: 'bump',
  postUpdateOptions: ['pnpmDedupe'],
  prConcurrentLimit: 5,
  // Keep in sync with minimumReleaseAge in pnpm-workspace.yaml: Renovate doesn't read pnpm's setting.
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-required',
  lockFileMaintenance: {
    enabled: true,
  },
  // Dependabot security updates open the fix PRs; this avoids a duplicate PR per alert.
  vulnerabilityAlerts: {
    enabled: false,
  },
  ignoreDeps: [
    // nuxt is upgraded with `nuxt upgrade`, which also dedupes its transitive tree
    'nuxt',
    'typescript',
    '@types/node',
    // pinned release candidate, upgraded manually
    'drizzle-orm',
    'drizzle-kit',
    // the pnpm version in packageManager; CI and the Dockerfiles install it
    'pnpm',
    // v2 needs upstream fixes before we can move
    'vue-stream-markdown',
  ],
  packageRules: [
    {
      // npm majors are done by hand with `pnpm pkg:update`
      matchDatasources: ['npm'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      // a Postgres major needs a data migration, not a tag bump
      matchDatasources: ['docker'],
      matchPackageNames: ['pgvector/pgvector', 'redis'],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
    {
      groupName: 'ai sdk',
      matchPackageNames: ['ai', '@ai-sdk/**'],
    },
    {
      groupName: 'better-auth',
      matchPackageNames: ['better-auth', '@better-auth/**'],
    },
    {
      groupName: 'nuxt modules',
      matchPackageNames: ['@nuxt/**', '@nuxtjs/**', 'nuxt-security'],
    },
    {
      groupName: 'tiptap',
      matchPackageNames: ['@tiptap/**'],
    },
    {
      groupName: 'oxc',
      matchPackageNames: ['oxlint', 'oxfmt', 'tsdown'],
    },
    {
      groupName: 'github actions',
      matchManagers: ['github-actions'],
    },
    {
      groupName: 'docker images',
      matchDatasources: ['docker'],
    },
    {
      // Node from engines, .nvmrc and setup-node is moved by hand.
      matchDepNames: ['node'],
      matchDatasources: ['!docker'],
      enabled: false,
    },
    {
      // Runtime base images carry the Node and Bun security fixes. Own PR, any
      // day, not a draft: merging it is the signal to cut a release. Must stay
      // below the 'docker images' rule to override its group.
      groupName: 'runtime images',
      matchDatasources: ['docker'],
      matchPackageNames: ['node', 'oven/bun'],
      pinDigests: true,
      schedule: ['at any time'],
      draftPR: false,
    },
  ],
}
