{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ragna-docs",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.ragna.io", "custom_domain": true }],
  // Public workers.dev link per preview build, so docs changes can be checked from the PR.
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs on non-production branches.
  // Empty because assets and settings stay top level; production routes must not go here.
  "previews": {}
}
