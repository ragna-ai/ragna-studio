{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun --watch src/index.ts",
    "preview": "bun dist/index.mjs",
    "check-types": "tsc --noEmit && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "test": "bun test",
    "test:setup": "pnpm --filter @repo/testing test:setup",
    "backfill:media": "bun scripts/backfill-media.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@repo/ai": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/config": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/export": "workspace:*",
    "@repo/linkedin": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/media": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/utils": "workspace:*",
    "@repo/workflow": "workspace:*",
    "hono": "^4.12.33",
    "http-status-codes": "^2.3.0",
    "unstorage": "^1.17.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/testing": "workspace:*",
    "@repo/ts-config": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
