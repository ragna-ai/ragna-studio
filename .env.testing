LOG_LEVEL="error"
AI_SDK_LOG_WARNINGS="false"
## Test-profile overrides, loaded ahead of .env when NODE_ENV=test.
DB_DATABASE="studio_test"
CREDITS_ENABLED="true"
CREDIT_MARKUP_BPS="NULL"
# Separate logical Redis db from dev's (db 0), so BullMQ jobs enqueued by
# tests never land in the queues the dev worker is consuming from.
REDIS_DB="1"
MEDIA_URL="https://media.test"
