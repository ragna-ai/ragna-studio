LOG_LEVEL="error"
AI_SDK_LOG_WARNINGS="false"
## Test-profile overrides, loaded ahead of .env when NODE_ENV=test.
DB_DATABASE="studio_test"
CREDITS_ENABLED="true"
CREDIT_MARKUP_BPS="NULL"
# Separate logical Redis db from dev's (db 0), so BullMQ jobs enqueued by
# tests never land in the queues the dev worker is consuming from.
REDIS_DB="1"
MEDIA_URL="https://media.test"
APP_KEY="base64:dGVzdC1hcHAta2V5LXRlc3QtYXBwLWtleS0xMjM0NTY="
GOOGLE_CLIENT_ID="test-google-client-id"
GOOGLE_CLIENT_SECRET="test-google-client-secret"
MICROSOFT_CLIENT_ID="test-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="test-microsoft-client-secret"
LINKEDIN_CLIENT_ID="test-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="test-linkedin-client-secret"
