{
  "name": "@repo/{{ name }}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  {{#if description}}
  "description": "{{ description }}",
  {{/if}}
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@repo/ts-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
