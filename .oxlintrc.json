{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "prefer-object-spread": "error",
    "no-restricted-properties": [
      "error",
      {
        "object": "Object",
        "property": "assign",
        "message": "Object.assign skips type checks (returns T & U), runs setters and honours __proto__. Use spread with overrides or Object.fromEntries (clean-code rule 9)."
      }
    ]
  },
  "overrides": [
    {
      "files": ["packages/testing/**"],
      "rules": {
        "no-restricted-properties": "off"
      }
    },
    {
      "files": ["packages/ai/src/tools/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "ai",
                "importNames": ["tool"],
                "message": "Write a ToolDefinition. Only tool-definition.ts turns definitions into AI SDK tools."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/ai/src/tools/tool-definition.ts",
        "packages/ai/src/tools/agent-context.tool.ts",
        "packages/ai/src/tools/dataset.tools.ts",
        "packages/ai/src/tools/document.tools.ts",
        "packages/ai/src/tools/image-gen.tool.ts",
        "packages/ai/src/tools/linkedin-draft.tool.ts",
        "packages/ai/src/tools/memory.tool.ts",
        "packages/ai/src/tools/task.tools.ts",
        "packages/ai/src/tools/video-gen.tool.ts",
        "packages/ai/src/tools/web-browser.tool.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
