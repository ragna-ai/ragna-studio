##
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3010"
## Set only if web/api are on different subdomains, e.g. ".example.com"
COOKIE_DOMAIN=

## Web app (apps/web) — public runtime config, read by the browser.
## Must be the externally reachable API URL. In production this must be
## https:// so the websocket composable (useWebSocketChannel.ts) derives
## wss:// instead of ws://.
NUXT_PUBLIC_API_BASE_URL="http://localhost:3010"

## Web app (apps/web): local containers can override CSP directives, e.g.
# NUXT_SECURITY_HEADERS_CONTENT_SECURITY_POLICY_CONNECT_SRC="'self' http://localhost:3010 ws://localhost:3010"

LOG_LEVEL="debug"
AI_SDK_LOG_WARNINGS="false"
## CORS — comma-separated list of allowed origins
TRUSTED_ORIGINS="http://localhost:3000"

## Credits (docs/credits/prd.md)
# Basis points; 10000 = cost price, 15000 = 1.5x. "NULL" disables the markup.
CREDIT_MARKUP_BPS="15000"
CREDITS_ENABLED="false"

## Chat title generation
CHAT_TITLE_MODEL_PROVIDER="anthropic"
CHAT_TITLE_MODEL="claude-haiku-4-5"

## Webbrowser
WEBBROWSER_PORT="3011"
WEBBROWSER_BASE_URL="http://localhost:3011"
BROWSER_NAVIGATION_TIMEOUT="25000"
BROWSER_BODY_LOAD_TIMEOUT="10000"
BROWSER_MAX_CONCURRENCY="4"

## Mail
MAIL_FROM="noreply@example.com"
MAIL_TRANSPORT="smtp"
SMTP_HOST="127.0.0.1"
SMTP_PORT="2525"
SMTP_USER=
SMTP_PASSWORD=
BREVO_API_KEY=
# Only mail received within this window (and after connecting) is auto-classified. Units: m, h, d, w.
EMAIL_AUTO_CLASSIFY_MAX_MESSAGE_AGE="1d"

## Redis
REDIS_HOST="localhost"
REDIS_PORT="6381"
REDIS_PASSWORD="changeme"
REDIS_DB="0"

## Database
DB_TYPE="postgres"
DB_HOST="localhost"
DB_PORT="5437"
DB_DATABASE="studio"
DB_USERNAME="postgres"
DB_PASSWORD="changeme"
DB_SSL="false"
DATABASE_POOL_SIZE="10"
## Overrides the DB_* parts above if set
# DATABASE_URL="postgres://postgres:changeme@localhost:5437/studio"

ENCRYPTION_PASSWORD="replace-me-with-a-strong-password"

## Better Auth (read directly by the better-auth package)
BETTER_AUTH_SECRET="replace-me-with-a-strong-secret"

## MCP server (docs/mcp/prd.md) — off by default. Comma-separated CIMD client ID URLs.
MCP_ENABLED="false"
MCP_ALLOWED_CLIENT_IDS=
MCP_ACCESS_TOKEN_TTL_SECONDS="3600"
MCP_REFRESH_TOKEN_TTL_SECONDS="2592000"

## Cloudflare R2
CF_REGION="auto"
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_IMAGES_BUCKET_NAME=
CF_DOCUMENTS_BUCKET_NAME=

## Payment redirects
PAYMENT_SUCCESS_URL="http://localhost:3000/"
PAYMENT_CANCEL_URL="http://localhost:3000/"

## Stripe
STRIPE_API_KEY=
STRIPE_SECRET_KEY="replace-me"
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SMALL_MONTHLY=
STRIPE_PRICE_ID_MEDIUM_MONTHLY=
STRIPE_PRICE_ID_LARGE_MONTHLY=

## Google (OAuth + Vertex + GenAI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_VERTEX_API_BASE_URL=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=
GOOGLE_GENAI_API_BASE_URL=
GOOGLE_GENAI_API_KEY=

## LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

## Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID="organizations"

## Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

## Login allowlist (comma-separated emails; empty = everyone allowed)
ALLOWED_LOGIN_EMAILS=

## Search
SERP_API_KEY=

## AI providers
BFL_API_BASE_URL=
BFL_API_KEY=
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_BASE_URL=
ANTHROPIC_API_KEY=
MISTRAL_API_BASE_URL=
MISTRAL_API_KEY=
LMSTUDIO_API_BASE_URL=
LMSTUDIO_API_KEY=
